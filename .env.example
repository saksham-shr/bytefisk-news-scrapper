# Local SQLite dedupe/queue store
DB_PATH=./data/scrapper.sqlite

# Local clone of the Bytefisk site repo — MDX output goes under
# <BYTEFISK_REPO_PATH>/src/content/news and /src/content/events
BYTEFISK_REPO_PATH=../bytefisk

# Telegram digest notifier (step 5) — leave blank to disable notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional, recommended keys for higher rate limits (never required for the
# open sources this service ingests by default)
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=

# Step 7 (funding ingestion, Tracxn/Crunchbase) is only built if one of
# these is actually set. Leave both blank (the default) and funding
# signal relies on the India news RSS sources from step 2 instead — see
# src/funding/checkFundingConfig.ts.
TRACXN_API_KEY=
CRUNCHBASE_API_KEY=
